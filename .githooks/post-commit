#!/bin/sh

# Auto-push the current branch after each successful commit so local and remote
# stay aligned without a separate manual sync step.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
remote=$(git config --get "branch.$branch.remote")
merge_ref=$(git config --get "branch.$branch.merge")

if [ -z "$remote" ]; then
  remote="origin"
fi

if [ -n "$merge_ref" ]; then
  remote_branch=${merge_ref#refs/heads/}
  git push "$remote" "HEAD:$remote_branch"
else
  git push "$remote" HEAD
fi

status=$?
if [ $status -ne 0 ]; then
  echo "post-commit: automatic push failed; run 'git push' manually." >&2
fi

exit 0
